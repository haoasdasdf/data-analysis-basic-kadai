        "import numpy as np\n",
        "\n",
        "a = np.array([[0,1],[2,3],[4,5]])\n",
        "print(a)\n",
        "b = np.array([[0,1,2,3],[4,5,6,7]])\n",
        "print(b)\n",
        "\n",
        "ab_dot = np.dot(a,b)\n",
        "print(ab_dot)\n",
        "\n",
        "ab_dot_max = ab_dot.max()\n",
        "print(ab_dot_max)"
